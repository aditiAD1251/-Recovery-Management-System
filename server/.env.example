# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/clrms

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:3000

# JWT Authentication Configuration
JWT_SECRET=your_super_secret_jwt_key_for_development_change_in_production
JWT_EXPIRES_IN=1d

# Development Seed Passwords (Optional override)
SEED_ADMIN_PASSWORD=Admin@123456
SEED_SUPERVISOR_PASSWORD=Supervisor@123456
SEED_AGENT_PASSWORD=Agent@123456
SEED_LEGAL_PASSWORD=Legal@123456
